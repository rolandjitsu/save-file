{
  "compilerOptions": {
    "target": "es2019",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2019", "dom", "dom.iterable"],
    "strict": true,
    "isolatedDeclarations": true,
    "declaration": true,
    "noEmit": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
